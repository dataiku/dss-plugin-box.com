{
    "meta": {
        "label": "Single Sign On",
        "description": "",
        "icon": "icon-cloud"
    },
    "defaultDefinableInline": false,
    "defaultDefinableAtProjectLevel": false,
    "pluginParams": [],
    "params": [
        {
            "name": "boxcom_oauth",
